# Used only by scripts/collect-pexels-candidates.py when collecting new local candidates.
PEXELS_API_KEY=

# Listing photo assistant. Fixture is the safe default and needs no external
# credentials. Set PROVIDER_MODE=live only for an explicit local live smoke
# with `docker compose --profile live up --build`.
PROVIDER_MODE=fixture
VITE_LISTING_ASSISTANT_MODE=fixture
VITE_LISTING_ASSISTANT_API_URL=http://127.0.0.1:3001
ASSISTANT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3001
SHOT_ASSESSOR_MODEL=gpt-5.6-luna
MEASUREMENT_LINE_MODEL=gpt-5.6-luna
VISION_GUIDANCE_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=256
OPENAI_MAX_RETRIES=0
GUIDANCE_CADENCE_SECONDS=2.0
GUIDANCE_MAX_CALLS_PER_SESSION=12
GUIDANCE_FAILURE_COOLDOWN_SECONDS=15.0
LIVEKIT_TOKEN_TTL_SECONDS=90
LIVEKIT_TOKEN_MAX_TTL_SECONDS=300

# Server-only provider settings. Keep all values empty in this example and
# never copy these names to VITE_* variables.
OPENAI_API_KEY=
# Optional local codex-proxy gateway. When set, the backend uses its
# Responses/SSE and image_generation compatibility path. Keep server-only.
OPENAI_BASE_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BACKGROUND_GENERATOR_URL=
REMBG_URL=
BACKGROUND_MODEL=gpt-image-2
# Preferred 3:4 canvas for composing the portrait product photo.
# The adapters always request PNG output with an opaque background.
BACKGROUND_IMAGE_QUALITY=high
BACKGROUND_IMAGE_SIZE=1200x1600
# If the Codex Proxy explicitly rejects only this custom size, the adapter
# makes one finite compatibility request at 1024x1536/high. It never retries
# timeouts, authentication failures, or malformed responses.

# UI/fixture development only. Set this explicitly instead of relying on the
# request hostname. Keep it false for a deployed or shared Worker environment.
FURIMA_LOCAL_FIXTURE_MODE=true
# Set true when running contract/security tools against the local server so
# normal API routes still exercise bearer authentication.
FURIMA_LOCAL_FIXTURE_REQUIRE_AUTH=false

# Operator API configuration. Leave empty for local UI/fixture mode; never commit values.
FURIMA_D1_API_TOKEN=
# Authenticated data-plane actor for HTTP API calls. The request body cannot override it.
FURIMA_D1_API_ACTOR_ID=buyer_01
FURIMA_D1_CONTROL_TOKEN=

# Explicit local UI/fixture intent. `memory` selects the in-process Sandbox
# store and is valid only with local fixture mode enabled.
FURIMA_STORAGE_MODE=memory

# Keep this value `development` for local work. Shared/staging/production must
# use the deployed environment name and reject local fixture/memory storage.
FURIMA_DEPLOYMENT_ENV=development

# Set `d1` for a Worker with a DB binding; the DB binding is then required.

# The sandbox-control Inspector is visible in dev builds only unless enabled explicitly.
VITE_ENABLE_SANDBOX_INSPECTOR=false
