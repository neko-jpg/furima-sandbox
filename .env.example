# Used only by scripts/collect-pexels-candidates.py when collecting new local candidates.
PEXELS_API_KEY=

# UI/fixture development only. Set this explicitly instead of relying on the
# request hostname. Keep it false for a deployed or shared Worker environment.
FURIMA_LOCAL_FIXTURE_MODE=true
# Set true when running contract/security tools against the local server so
# normal API routes still exercise bearer authentication.
FURIMA_LOCAL_FIXTURE_REQUIRE_AUTH=false

# Operator API configuration. Leave empty for local UI/fixture mode; never commit values.
FURIMA_D1_API_TOKEN=
# Authenticated data-plane actor for HTTP API calls. The request body cannot override it.
FURIMA_D1_API_ACTOR_ID=buyer_01
FURIMA_D1_CONTROL_TOKEN=

# Explicit local UI/fixture intent. `memory` selects the in-process Sandbox
# store and is valid only with local fixture mode enabled.
FURIMA_STORAGE_MODE=memory

# Keep this value `development` for local work. Shared/staging/production must
# use the deployed environment name and reject local fixture/memory storage.
FURIMA_DEPLOYMENT_ENV=development

# Set `d1` for a Worker with a DB binding; the DB binding is then required.

# The sandbox-control Inspector is visible in dev builds only unless enabled explicitly.
VITE_ENABLE_SANDBOX_INSPECTOR=false
